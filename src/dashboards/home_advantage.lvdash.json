{
  "datasets": [
    {
      "name": "ds_teams",
      "displayName": "Home and away records",
      "queryLines": [
        "SELECT\n",
        "  competition_name, competition_type, season, team_name,\n",
        "  home_played, home_won, home_drawn, home_lost, home_points,\n",
        "  away_played, away_points,\n",
        "  try_divide(home_points, home_played) AS home_ppg,\n",
        "  try_divide(away_points, away_played) AS away_ppg,\n",
        "  try_divide(home_points, home_played) - try_divide(away_points, away_played) AS ppg_gap,\n",
        "  home_played >= 10 AND away_played >= 10 AS enough_games,\n",
        "  CASE WHEN try_divide(away_points, away_played) > try_divide(home_points, home_played) THEN 1 ELSE 0 END AS better_away\n",
        "FROM home_advantage\n",
        "ORDER BY ppg_gap DESC\n"
      ],
      "columns": [
        {
          "displayName": "Matches",
          "description": "Matches with a home side, each counted once (from the home team's row)",
          "expression": "SUM(`home_played`)"
        },
        {
          "displayName": "Home share of points",
          "description": "The home team's points as a share of all points. 50% = no home advantage",
          "expression": "SUM(`home_points`) / (SUM(`home_points`) + SUM(`away_points`))"
        },
        {
          "displayName": "Home wins",
          "description": "Share of matches the home team won",
          "expression": "SUM(`home_won`) / SUM(`home_played`)"
        },
        {
          "displayName": "Draws",
          "description": "Share of matches drawn",
          "expression": "SUM(`home_drawn`) / SUM(`home_played`)"
        },
        {
          "displayName": "Away wins",
          "description": "Share of matches the away team won",
          "expression": "SUM(`home_lost`) / SUM(`home_played`)"
        },
        {
          "displayName": "Teams better away",
          "description": "Share of teams with more points per game away than at home",
          "expression": "AVG(`better_away`)"
        }
      ]
    }
  ],
